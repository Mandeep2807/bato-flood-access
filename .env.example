# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# BATO reads these from the process environment. To load the file in a shell:
#   set -a; source .env; set +a

# Optional: use a different config directory (must contain config.yaml and thresholds.yaml).
# BATO_CONFIG_DIR=/absolute/path/to/config

# Copernicus Data Space Ecosystem (CDSE) account - https://dataspace.copernicus.eu
# NOT needed for catalogue search (Step 2A): the OData catalogue is public.
# Needed from the download milestone onwards (token via the cdse-public client).
CDSE_USERNAME=
CDSE_PASSWORD=
# Only if two-factor authentication is enabled on the account (one-time code).
# CDSE_TOTP=

# SITREP Copilot (dashboard AI panel) - an LLM reached from the local BATO server only; the key never reaches the
# browser. Leave unset to keep the copilot unavailable (the rest of the dashboard is unaffected). See docs/copilot.md.
# BATO_LLM_PROVIDER=openai          # openai (any OpenAI-compatible endpoint) or anthropic
# BATO_LLM_MODEL=gpt-4o-mini
# BATO_LLM_API_KEY=
# BATO_LLM_BASE_URL=                # optional, e.g. http://localhost:11434/v1 for a local Ollama (no key needed)
